{
  "name": "agent2api-mobile",
  "version": "3.2.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Agent2API 手机端 —— 响应式 Web / PWA，消费 ui-kit（Base UI + Tailwind v4），产物落 ui/m/",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:native": "tsc --noEmit && vite build --mode apk",
    "build:apk": "npm run build:native && cap sync android",
    "build:ios": "npm run build:native && cap sync ios",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "apk": "npm run build:apk && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
