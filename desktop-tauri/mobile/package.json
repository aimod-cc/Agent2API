{
  "name": "agent2api-mobile",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "Agent2API 手机端 —— 响应式 Web / PWA，消费 ui-kit（Base UI + Tailwind v4），产物落 ui/m/",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:apk": "tsc --noEmit && vite build --mode apk && cap sync android",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "apk": "npm run build:apk && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@capacitor/cli": "^8.5.3"
  }
}
