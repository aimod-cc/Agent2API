{
  "name": "agent2api-ui-islands",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent2API 桌面端 React 岛 —— 消费 ui-kit 私有组件库（Base UI + Tailwind v4），产物落 ui/islands/",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.login.config.ts",
    "watch": "vite build --watch",
    "watch:login": "vite build --watch --config vite.login.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
