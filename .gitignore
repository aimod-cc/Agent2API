# 依赖目录
node_modules/

# Tauri 工程依赖与构建产物
desktop-tauri/node_modules/
desktop-tauri/src-tauri/target/
desktop-tauri/src-tauri/gen/schemas/

# cargo 编译产物（src-tauri/.cargo/config.toml 把 target-dir 指到了项目根）
/target/

# 本地开发过程产物
.zcode/
.verify/
prototype/
# ZCode 的忽略配置文件本身（本机工具配置，不入库）
.zcodeignore

# 第三方参考项目（仅本地分析用）
Acankao/
desktop-tauri/web

# 运行日志与截图产物
logs/
desktop-tauri/window-shot.png

# 发布说明草稿只在本机留存，不入库；docs/ 下的其它文档正常入库
/docs/release-notes/

# 发版脚本下载的 CI 构建产物（scripts/release.sh）
dist/

# Docker 部署：密钥与运行数据不入库
.env
data/

# ── 手机 APK（Capacitor）──────────────────────────────────────
# android/ 是 `npx cap add android` 生成的原生工程，需要入库：
# 图标、Manifest、网络安全策略都是手改过的，重新生成会丢。
# 但下面这些是构建机本地状态，不该进仓库：
desktop-tauri/mobile/android/.gradle/
desktop-tauri/mobile/android/build/
desktop-tauri/mobile/android/app/build/
desktop-tauri/mobile/android/local.properties
desktop-tauri/mobile/android/.idea/
desktop-tauri/mobile/android/capacitor-cordova-android-plugins/build/
# 构建中间产物（android-www 由 npm run build:apk 生成，再同步进 android/）
desktop-tauri/mobile/android-www/

# APK 签名密钥与配套密码：**不入库**。
# 拿着密钥 + 密码就能签一个同包名的假 APK 覆盖安装；本仓库是公开的，
# 所以两者只留在打包机上。新机器打 release 包时按
# desktop-tauri/mobile/android/keystore.properties.example 建一份
# keystore.properties，再把密钥放回 android/ 目录。
*.jks
*.keystore
desktop-tauri/mobile/android/keystore.properties

# 本地测试跑出来的运行数据（数据库、加密密钥、日志）
.agenttest2/
