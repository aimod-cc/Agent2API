+#[cfg(test)]
+mod client_system_tests {
+    use super::*;
+
+    #[test]
+    fn client_instructions_keep_the_three_block_structure() {
+        let texts = GatewayBlocks {
+            identity: "identity".into(),
+            stable: "stable".into(),
+            dynamic: "dynamic".into(),
+        };
+        let instructions = "请准确回答用户的问题。\n保留所有上下文。";
+        let blocks = system_blocks(&texts, Some(&json!(instructions)));
+        assert_eq!(blocks.len(), 3);
+        assert_eq!(blocks[0]["text"], "identity");
+        assert_eq!(blocks[1]["text"], "stable");
+        assert_eq!(blocks[2]["text"], format!("\n\ndynamic\n\n{instructions}"));
+        assert!(blocks.iter().all(|b| b["cache_control"]["type"] == "ephemeral"));
+    }
+
+    #[test]
+    fn multiple_client_blocks_preserve_order_and_text() {
+        let texts = GatewayBlocks { identity: "i".into(), stable: "s".into(), dynamic: "d".into() };
+        let existing = json!([
+            {"type": "text", "text": "第一段", "cache_control": {"type": "ephemeral"}},
+            {"type": "text", "text": "第二段"}
+        ]);
+        let blocks = system_blocks(&texts, Some(&existing));
+        assert_eq!(blocks.len(), 3);
+        assert_eq!(blocks[2]["text"], "\n\nd\n\n第一段\n\n第二段");
+    }
+
+    #[test]
+    fn no_client_instructions_leave_the_original_blocks_unchanged() {
+        let texts = GatewayBlocks { identity: "i".into(), stable: "s".into(), dynamic: "d".into() };
+        let blocks = system_blocks(&texts, None);
+        assert_eq!(blocks.len(), 3);
+        assert_eq!(blocks[2]["text"], "\n\nd");
+    }
 }

