# Agent2API 服务端环境变量（systemd EnvironmentFile 格式）
#
# 这个文件由 install.sh 从 agent2api.env.example 复制生成。
# 改完执行：systemctl restart agent2api
#
# ── 数据目录 ────────────────────────────────────────────────
# 库文件（SQLite）、配置、日志都在这里。install.sh 会自动写入实际路径，
# 一般不需要改。要换位置的话记得同时改单元文件里的 ReadWritePaths。
AGENT2API_PROXY_HOME=/var/lib/agent2api

# ── 监听 ────────────────────────────────────────────────────
# 监听地址。0.0.0.0 = 所有网卡（服务器形态的默认值）。
# 只想让本机访问（前面有 nginx 反代）就改成 127.0.0.1。
AGENT2API_HOST=0.0.0.0

# 网关 + 面板端口
AGENT2API_PROXY_PORT=3065

# 可选：把管理面板（界面 + /api/*）拆到独立端口，主端口只留 /v1 网关。
# 公网部署时防火墙只放行主端口，就能把管理面留在内网。
# 启用后建议 HOST 仍为 0.0.0.0 但用防火墙限制该端口来源。
#AGENT2API_PANEL_PORT=3066

# ── 管理员（可选）────────────────────────────────────────────
# 留空 = 首次打开面板时注册（推荐，不用在这里放密码）。
# 填了 = 跳过注册流程，直接用这里的账号登录（无人值守 / IaC 部署用）。
# 密码可以填明文（启动时自动转 bcrypt，库里只存哈希），
# 也可以填已是哈希的 AGENT2API_ADMIN_PASSWORD_HASH（优先于明文，
# `htpasswd -nBC 10 agent2api` 的输出整行可粘）。
#AGENT2API_ADMIN_USER=admin
#AGENT2API_ADMIN_PASSWORD=

# ── 网关 API Key（可选）──────────────────────────────────────
# 预置一把网关 Key，跳过「打开面板手动创建第一把」这一步。
# 适合把这台机器交给脚本 / CI 直接用的场景。
# 注意：这是**启动注入**的通用口令，不带逐把 Key 的模型 / 提供商白名单
# （那些限制只能对面板里创建的 Key 生效，见 core/api_keys.rs 的说明）。
#AGENT2API_PROXY_API_KEY=sk-a2a-请换成你自己的随机串

# ── 安全闸门 ────────────────────────────────────────────────
# 未配置任何 API Key 时，/v1/* 默认拒绝服务（fail-closed）。
# 纯内网、确有把握的部署才设成 1 全放行 —— 它会同时关闭面板的注册闸门。
#AGENT2API_ALLOW_NO_KEY=0

# 登录页人机验证（1 开启 / 0 关闭）
AGENT2API_CAPTCHA_ENABLED=1

# 调试日志
#AGENT2API_VERBOSE=1

# ── 日志 ────────────────────────────────────────────────────
# 服务形态的日志文件（systemd 还会另存一份到 journal）。
# 不设则落到 {AGENT2API_PROXY_HOME}/logs/server.log。
#AGENT2API_LOG_FILE=/var/lib/agent2api/logs/server.log
